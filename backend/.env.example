# Database Credentials
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST= 
DATABASE_PORT=
DATABASE_NAME=

# jwt secret keys
JWT_SECRET_KEY=

# Service-to-service API key for the machine JSON export (GET /api/v1/risks/export).
# Consumed by AI-Q's Risk Intellect client via the X-API-Key header.
# Required in production; when unset the export endpoint fails closed (401).
SERVICE_API_KEY=

BACKEND_PORT=

# running in local
BASE_URL=

#chinmayee
EMAIL_SERVICE_TYPE=
SENDER_EMAIL_ID=
SENDER_EMAIL_PASSWORD=

# Invite emails: link target for "Sign in" (frontend URL, no trailing slash)
INVITE_APP_URL=

# Python ingestion + LLM (required for job worker risk extraction)
PYTHON_PORT=5006
PYTHON_INGEST_URL=http://localhost:5006

# LLM for risk extraction (Python reads these via env_bootstrap from this file)
USE_BEDROCK=true
AWS_REGION=us-east-1
# Bearer token for Bedrock inference profiles (required for Admin profile picker + testing)
AWS_BEARER_TOKEN_BEDROCK=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Primary model (full id or short alias). Fallback defaults to Claude 3 Sonnet 200k.
BEDROCK_MODEL_ID=us.anthropic.claude-3-sonnet-20240229-v1:0:200k
BEDROCK_MODEL=us.anthropic.claude-3-sonnet-20240229-v1:0:200k
# Optional override for invoke fallback: BEDROCK_FALLBACK_MODEL=
# PYTHON_HOST=localhost
# PYTHON_RELOAD=1
# Set true to use stdin/stdout CLI instead of HTTP (legacy)
# PYTHON_INGEST_USE_CLI=false
# PYTHON_BIN=python

# LLM risk extraction (python/app/extraction + app/llm/*)
# Pick ONE backend (default: local HuggingFace model):
# USE_BEDROCK=true
# BEDROCK_MODEL=claude-haiku-4-5
# AWS_REGION=us-east-1
# USE_OPENAI=true
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# USE_SAGEMAKER=true
# SAGEMAKER_ENDPOINT_NAME=
# USE_CISCO=true
# HF_TOKEN=
# LOCAL_MODEL_ID=Qwen/Qwen2.5-3B-Instruct
# CHUNK_THRESHOLD_CHARS=6000
# CHUNK_MAX_TOKENS=1024
# CHUNK_OVERLAP=100
# USE_CHUNKING=true

# RSS discovery (npm run discovery)
# AUTO_INGEST_INTERVAL_MIN=15
# AUTO_INGEST_MAX_PER_CYCLE=50

# Application logging (Winston — table files + PostgreSQL application_logs)
# LOG_LEVEL=debug
# LOG_DIR=./logs

# Number of reverse-proxy hops in front of the API (nginx = 1). Do not set true.
# TRUST_PROXY=1
# WEBHOOK_SIGNING_SECRET=
# WEBHOOK_API_KEY_EVENT=api_key.generate
# WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
# WEBHOOK_RATE_LIMIT_MAX=30
# API_KEY_CREATE_RATE_LIMIT_WINDOW_MS=60000
# API_KEY_CREATE_RATE_LIMIT_MAX=10

# Risk matching / scoring
# REVIEW_QUALITY_THRESHOLD=0.75
# MATCH_JUDGE_ENABLED=true
# RISK_DEDUP_THRESHOLD=0.92
# MATCH_EVIDENCE_GATE_ENABLED=false

