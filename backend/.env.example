# Database Credentials
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST= 
DATABASE_PORT=
DATABASE_NAME=

# jwt secret keys
JWT_SECRET_KEY=

# Service-to-service API key for the machine JSON export (GET /api/v1/risks/export).
# Consumed by AI-Q's Risk Intellect client via the X-API-Key header.
# Required in production; when unset the export endpoint fails closed (401).
SERVICE_API_KEY=

BACKEND_PORT=

# running in local
BASE_URL=

#chinmayee
EMAIL_SERVICE_TYPE=
SENDER_EMAIL_ID=
SENDER_EMAIL_PASSWORD=

# Invite emails: link target for "Sign in" (frontend URL, no trailing slash)
INVITE_APP_URL=

# Python ingestion + LLM (required for job worker risk extraction)
PYTHON_PORT=5006
PYTHON_INGEST_URL=http://localhost:5006

# LLM for risk extraction (Python reads these via env_bootstrap from this file)
USE_BEDROCK=true
AWS_REGION=us-east-1
# Cross-region inference profile prefix (BUG-12): us | eu | apac | global.
# When unset it is derived from AWS_REGION (us-* -> us, eu-* -> eu, ap-* -> apac);
# default is us., preserving current behaviour. Set explicitly for EU/APAC.
# BEDROCK_PROFILE_PREFIX=
# Bearer token for Bedrock inference profiles (required for Admin profile picker + testing)
AWS_BEARER_TOKEN_BEDROCK=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Primary model (full id or short alias).
# NOTE (BUG-13): the id below is Claude 3 Sonnet (2024) and is retired/outdated.
# It is kept only to preserve current behaviour — replace with the current model
# once confirmed (pending Asad). The code no longer hard-codes it; the default is
# read from BEDROCK_DEFAULT_MODEL below.
BEDROCK_MODEL_ID=us.anthropic.claude-3-sonnet-20240229-v1:0:200k
BEDROCK_MODEL=us.anthropic.claude-3-sonnet-20240229-v1:0:200k
# Optional override for invoke fallback: BEDROCK_FALLBACK_MODEL=
# Default/fallback Bedrock model when BEDROCK_MODEL is unset (BUG-13). When unset,
# the code keeps the legacy Claude 3 Sonnet default above. Set to the current id.
# BEDROCK_DEFAULT_MODEL=
# Catalog-match judge model. Defaults to Claude Haiku 4.5 when unset.
# BEDROCK_JUDGE_MODEL=
# Bedrock API for extraction (BUG-11): converse (default, every text model) or
# invoke (legacy Anthropic-only body). The tool-use loop always uses invoke.
# BEDROCK_API=converse
# Prompt caching via Converse cachePoint (BUG-10): auto (models known to
# support it: Claude 3.5 Haiku and later, Amazon Nova), true, or false.
# BEDROCK_PROMPT_CACHE=auto
# PYTHON_HOST=localhost
# PYTHON_RELOAD=1
# Set true to use stdin/stdout CLI instead of HTTP (legacy)
# PYTHON_INGEST_USE_CLI=false
# PYTHON_BIN=python

# LLM risk extraction (python/app/extraction + app/llm/*)
# Pick ONE backend (default: local HuggingFace model):
# USE_BEDROCK=true
# BEDROCK_MODEL=claude-haiku-4-5
# AWS_REGION=us-east-1
# USE_OPENAI=true
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# USE_SAGEMAKER=true
# SAGEMAKER_ENDPOINT_NAME=
# USE_CISCO=true
# HF_TOKEN=
# LOCAL_MODEL_ID=Qwen/Qwen2.5-3B-Instruct
# Extraction strategy (BUG-05). auto = one whole-document call when the paper
# fits the model's context window (see python/app/llm/model_registry.py),
# otherwise large chunks merged by ONE synthesis call. whole / chunked force it.
# EXTRACTION_MODE=auto
# Override the registry's context window for every model (tokens).
# MODEL_CONTEXT_TOKENS=
# Chunk size when chunking is unavoidable. Default: as large as the budget
# allows (up to 60k tokens). The old 1024-token default split a paper into
# 8-39 independent calls and mixed their results.
# CHUNK_MAX_TOKENS=
# CHUNK_OVERLAP=

# RSS discovery (npm run discovery)
# AUTO_INGEST_INTERVAL_MIN=15
# AUTO_INGEST_MAX_PER_CYCLE=50

# Application logging (Winston — table files + PostgreSQL application_logs)
# LOG_LEVEL=debug
# LOG_DIR=./logs

# Number of reverse-proxy hops in front of the API (nginx = 1). Do not set true.
# TRUST_PROXY=1
# WEBHOOK_SIGNING_SECRET=
# WEBHOOK_API_KEY_EVENT=api_key.generate
# WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
# WEBHOOK_RATE_LIMIT_MAX=30
# API_KEY_CREATE_RATE_LIMIT_WINDOW_MS=60000
# API_KEY_CREATE_RATE_LIMIT_MAX=10

# Risk matching / scoring
# Unit score (0–1) below which a risk is routed to human review. Code default
# is 0.9 (BUG-06); set this to override. (Was documented as 0.75 but unused.)
# REVIEW_QUALITY_THRESHOLD=0.9
# Independent verifier pass (BUG-06): a second model call grades every record
# against the source on four checks; any failure routes it to Review with the
# "Verifier" label. Defaults on. VERIFIER_MODEL defaults to the extraction model
# (a stronger model such as Sonnet is recommended). Records whose grounding
# score is below VERIFIER_GROUNDING_MIN are also routed to Review.
# ENABLE_VERIFIER=true
# VERIFIER_MODEL=
# VERIFIER_GROUNDING_MIN=0.6
# MATCH_JUDGE_ENABLED=true
# RISK_DEDUP_THRESHOLD=0.92
# MATCH_EVIDENCE_GATE_ENABLED=false

