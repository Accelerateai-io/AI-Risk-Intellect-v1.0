{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "concurrently -k -n node,py -c blue,green \"npm run dev:api\" \"npm run py:dev\"",
    "dev:all": "concurrently -k -n api,py,worker -c blue,green,magenta \"npm run dev:api\" \"npm run py:dev\" \"npm run worker\"",
    "dev:api": "tsx watch src/server.ts",
    "py:dev": "cross-env PYTHON_PORT=5006 PYTHON_HOST=127.0.0.1 PYTHON_RELOAD=0 npm --prefix ../python run dev",
    "py:dev:watch": "cross-env PYTHON_PORT=5006 PYTHON_HOST=127.0.0.1 PYTHON_RELOAD=1 npm --prefix ../python run dev",
    "py:start": "cross-env PYTHON_PORT=5006 PYTHON_RELOAD=0 npm --prefix ../python run start",
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node --watch dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/schema/migrate.ts",
    "db:repair-jobs": "tsx scripts/repairJobsTable.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed:admin": "tsx src/scripts/seedAdmin.ts",
    "db:reset": "tsx src/scripts/resetDb.ts",
    "discovery": "tsx src/workers/discoveryService.ts",
    "discovery:once": "cross-env RUN_ONCE=true tsx src/workers/discoveryService.ts",
    "worker": "tsx src/workers/jobWorker.ts",
    "workflow:check": "tsx src/scripts/workflowCheck.ts",
    "backfill:catalog-embeddings": "tsx src/scripts/backfillCatalogEmbeddings.ts",
    "backfill:matches": "tsx src/scripts/backfillRiskMatches.ts",
    "backfill:scoring": "tsx src/scripts/backfillRiskScoring.ts",
    "reextract:all": "tsx src/scripts/reextractAllArticles.ts",
    "report:match-distribution": "tsx src/scripts/matchDistributionReport.ts",
    "models:refresh": "tsx scripts/refreshBedrockCatalog.ts",
    "py:install": "npm --prefix ../python run install",
    "install:all": "npm install && npm run py:install",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock": "^3.985.0",
    "@aws-sdk/client-bedrock-runtime": "^3.985.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "nodemailer": "^6.9.16",
    "pg": "^8.20.0",
    "rss-parser": "^3.13.0",
    "ua-parser-js": "^2.0.10",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.12.2",
    "@types/pg": "^8.16.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3"
  }
}
