{
  "type": "object",
  "required": ["risk", "risk_scoring", "controls", "justification"],
  "properties": {
    "_source": { "type": "string" },
    "_meta": { "type": "object" },
    "risk": {
      "type": "object",
      "required": [
        "risk_title",
        "domains",
        "description",
        "source_type",
        "evidence_type",
        "demonstrated_finding",
        "stated_implication",
        "paper_stance",
        "proposed_mitigation",
        "mitigations_in_source"
      ],
      "properties": {
        "risk_title": { "type": "string" },
        "domains": { "type": "string" },
        "description": { "type": "string" },
        "attack_vector": { "type": "string" },
        "observable_indicators": { "type": "string" },
        "data_to_identify_risk": { "type": "string" },
        "evidence_sources": { "type": "string" },
        "intent": { "type": "string" },
        "timing": { "type": "string" },
        "risk_type_detected": { "type": "string" },
        "primary_risk": { "type": "string" },
        "secondary_risks": { "type": "string" },
        "sector": { "type": "string" },
        "industry": { "type": "string" },
        "ai_product_name": { "type": ["string", "null"] },
        "ai_product_vendor": { "type": ["string", "null"] },
        "source_type": {
          "type": "string",
          "enum": [
            "empirical_study",
            "position_paper",
            "survey",
            "incident_report",
            "news",
            "vendor_doc"
          ]
        },
        "evidence_type": {
          "type": "string",
          "enum": ["demonstrated", "hypothesized", "mitigation_target"]
        },
        "demonstrated_finding": { "type": ["string", "null"] },
        "stated_implication": { "type": ["string", "null"] },
        "paper_stance": {
          "type": "string",
          "enum": [
            "documents_problem",
            "proposes_mitigation",
            "evaluates_system",
            "surveys",
            "not_applicable"
          ]
        },
        "proposed_mitigation": { "type": ["string", "null"] },
        "mitigations_in_source": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "risk_scoring": {
      "type": "object",
      "properties": {
        "likelihood": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
        "likelihood_reasoning": { "type": "string" },
        "impact": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
        "impact_reasoning": { "type": "string" },
        "loss_categories": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "Productivity",
              "Response",
              "Replacement",
              "Fines & Judgments",
              "Competitive Advantage",
              "Reputation"
            ]
          }
        },
        "severity_score": { "type": ["integer", "null"], "minimum": 1, "maximum": 25 },
        "severity_band": { "type": ["string", "null"] }
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "control_ref": { "type": "string" },
          "name": { "type": "string" },
          "why": { "type": "string" },
          "score": { "type": "number" }
        }
      }
    },
    "analysis": {
      "type": "object",
      "properties": {
        "risk_identified": { "type": "string" },
        "article_context": { "type": "string" },
        "alignment_reasoning": { "type": "string" }
      }
    },
    "justification": {
      "type": "object",
      "properties": {
        "decision_rationale": { "type": "string" },
        "taxonomy_mapping": { "type": "object" },
        "evidence_breakdown": { "type": "array" },
        "self_assessment": { "type": "object" }
      }
    }
  }
}
